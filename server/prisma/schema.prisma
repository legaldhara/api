generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(uuid()) @db.Uuid
  uid             String?             @unique
  fullName        String
  email           String              @unique
  phone           String?             @unique
  dob             DateTime?
  gender          String?
  city            String?
  isActive        Boolean             @default(false)
  role            Role                @default(USER)
  termsAccepted   Boolean             @default(false)
  termsAcceptedAt DateTime?
  emailVerified   Boolean             @default(false)
  phoneVerifiedAt DateTime?
  lastLogin       DateTime?
  loginAttempts   Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  applications    Application[]
  updates         ApplicationUpdate[] @relation("UserUpdates")
  tokens          Token[]
  query           UserQuery[]
  paymentCharges  PaymentCharge[]
  refundRequests  PaymentRefund[]       @relation("PaymentRefundRequestedBy")
  documents       Document[]          @relation("UserDocuments")
  certificateRequests CertificateRequest[]   @relation("UserCertificateRequests")
  certificateUpdates  CertificateUpdate[]    @relation("UserCertificateUpdates")
  userPlans           UserPlan[]           // âœ… New relation
  adminSecurity       AdminSecurity?
  uploadedAssets      UploadedAsset[]
  adminInvitation     AdminInvitation?
}

model AdminSecurity {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  encryptedTotpSecret  String
  enabledAt            DateTime?
  recoveryCodeHashes   String[]
  lastAcceptedTimeStep BigInt?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpChallenge {
  id             String      @id @default(uuid()) @db.Uuid
  purpose        OtpPurpose
  phoneHash      String
  encryptedPhone String
  codeDigest     String
  expiresAt      DateTime
  resendAt       DateTime
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5)
  consumedAt     DateTime?
  invalidatedAt  DateTime?
  verifiedUid    String?
  verifiedAt     DateTime?
  requestIpHash  String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([phoneHash, purpose, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
}
model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
}


model UploadedAsset {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @db.Uuid
  publicId     String        @unique
  secureUrl    String
  resourceType String
  mimeType     String
  originalName String
  sizeBytes    Int
  status       AssetStatus   @default(TEMPORARY)
  context      AssetContext?
  referenceId  String?
  attachedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([context, referenceId])
}

model AdminInvitation {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @unique @db.Uuid
  deliveryStatus InvitationDeliveryStatus
  lastSentAt     DateTime?
  lastErrorAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Token {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  type      TokenType
  role      Role
  expiredAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  note              String?
  description       String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  price             Decimal
  benifits          String?
  deliverables      String[]
  docRequired       String[]
  governmentCharges Decimal      @default(0)
  premiumPrice      Decimal       @default(0)

  applications      Application[]
}

model Application {
  id                String              @id @default(uuid()) @db.Uuid
  ticketNo          String              @unique
  userId            String              @db.Uuid
  serviceId         String              @db.Uuid
  applicationStatus ApplicationStatus   @default(AWAITING_ACTION)
  objectionReason   String?
  createdAt         DateTime            @default(now())
  autoCloseAt       DateTime?
  businessName      String?
  serviceFor        String?
  serviceName       String?
  deletedAt         DateTime?
  service           Service             @relation(fields: [serviceId], references: [id])
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  updates           ApplicationUpdate[]
  paymentCharges    PaymentCharge[]
}

model ApplicationUpdate {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  updaterBy         String            @db.Uuid
  message           String?
  createdAt         DateTime          @default(now())
  updateCharges     Decimal?
  meta              Json?
  newStatus         ApplicationStatus
  paymentId         String?
  prevStatus        ApplicationStatus
  pendingPayment    Boolean           @default(false) // âœ… indicates admin requested payment
  pendingDocs       Boolean           @default(false) // âœ… indicates user must update docs
  type              PaymentType?
  UpdateType        UpdateType?
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  updater           User              @relation("UserUpdates", fields: [updaterBy], references: [id], onDelete: Cascade)
  sourcePaymentCharge PaymentCharge?
}

model UserQuery {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  subject    String
  message    String
  isResolved Boolean   @default(false)
  response   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  queryNo    String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PaymentCharge {
  id                        String              @id @default(uuid()) @db.Uuid
  userId                    String              @db.Uuid
  targetType                PaymentTargetType
  applicationId             String?             @db.Uuid
  certificateRequestId      String?             @db.Uuid
  planId                    String?             @db.Uuid
  sourceApplicationUpdateId String?             @unique @db.Uuid
  sourceCertificateUpdateId String?             @unique @db.Uuid
  category                  PaymentCategory
  amountMinor               Int
  currency                  String              @default("INR")
  purpose                   String
  status                    PaymentChargeStatus @default(OPEN)
  paidAttemptId             String?             @unique @db.Uuid
  paidAt                    DateTime?
  refundedAt                DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  user                      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  application               Application?        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  certificateRequest        CertificateRequest? @relation(fields: [certificateRequestId], references: [id], onDelete: Restrict)
  plan                      Plan?               @relation(fields: [planId], references: [id], onDelete: Restrict)
  sourceApplicationUpdate   ApplicationUpdate?  @relation(fields: [sourceApplicationUpdateId], references: [id], onDelete: Restrict)
  sourceCertificateUpdate   CertificateUpdate?  @relation(fields: [sourceCertificateUpdateId], references: [id], onDelete: Restrict)
  attempts                  PaymentAttempt[]    @relation("ChargeAttempts")
  paidAttempt               PaymentAttempt?     @relation("PaidAttempt", fields: [paidAttemptId], references: [id], onDelete: Restrict)
  refunds                   PaymentRefund[]

  @@index([userId, createdAt])
  @@index([applicationId])
  @@index([certificateRequestId])
  @@index([planId])
}

model PaymentAttempt {
  id                 String               @id @default(uuid()) @db.Uuid
  chargeId           String               @db.Uuid
  gateway            PaymentGateway       @default(RAZORPAY)
  status             PaymentAttemptStatus @default(CREATING)
  amountMinor        Int
  currency           String               @default("INR")
  gatewayOrderId     String?              @unique
  gatewayPaymentId   String?              @unique
  paymentMethod      String?
  failureCode        String?
  failureDescription String?
  gatewayResponse    Json?
  expiresAt          DateTime
  settledAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  charge             PaymentCharge        @relation("ChargeAttempts", fields: [chargeId], references: [id], onDelete: Restrict)
  settledCharge      PaymentCharge?        @relation("PaidAttempt")
  webhookEvents      PaymentWebhookEvent[]
  refund             PaymentRefund?
  userPlan           UserPlan?

  @@index([chargeId, status])
  @@index([status, updatedAt])
}

model PaymentWebhookEvent {
  id               String               @id @default(uuid()) @db.Uuid
  eventKey         String               @unique
  providerEventId  String?
  payloadDigest    String
  eventType        String
  gatewayOrderId   String?
  gatewayPaymentId String?
  attemptId        String?              @db.Uuid
  status           PaymentWebhookStatus @default(RECEIVED)
  failureReason    String?
  receivedAt       DateTime             @default(now())
  processedAt      DateTime?
  attempt          PaymentAttempt?      @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([providerEventId])
  @@index([attemptId])
}

model PaymentRefund {
  id               String              @id @default(uuid()) @db.Uuid
  chargeId         String              @db.Uuid
  attemptId        String              @unique @db.Uuid
  requestedBy      String              @db.Uuid
  amountMinor      Int
  currency         String              @default("INR")
  status           PaymentRefundStatus @default(REQUESTED)
  reason           String
  gatewayRefundId  String?             @unique
  gatewayResponse  Json?
  requestedAt      DateTime            @default(now())
  processedAt      DateTime?
  updatedAt        DateTime            @updatedAt
  charge           PaymentCharge       @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  attempt          PaymentAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  requestedByAdmin User                @relation("PaymentRefundRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([chargeId])
  @@index([requestedBy])
}

model ScheduledJobLease {
  name      String   @id
  holderId  String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model Plan {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Decimal
  subscribe   Boolean   @default(false)
  duration    Int       // e.g., in days or months
  benefits    String[]
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  paymentCharges PaymentCharge[]
  userPlans   UserPlan[]  // âœ… New relation
}


model UserPlan {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  planId      String      @db.Uuid
  paymentAttemptId String? @unique @db.Uuid
  startDate   DateTime    @default(now())
  endDate     DateTime
  isActive    Boolean     @default(true)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
}

model Notification {
  id               String             @id @default(uuid()) @db.Uuid
  title            String
  body             String
  role             Role
  audienceType     AudienceType
  notificationType String             @default("general")
  clickAction      String             @default("")
  createdAt        DateTime           @default(now())
  reads            NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @db.Uuid
  userId         String       @db.Uuid
  isRead         Boolean      @default(false)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  url         String
  publicId    String
  userId      String   @db.Uuid
  user        User     @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model CertificateRequest {
  id             String                   @id @default(uuid()) @db.Uuid
  requestNo      String                   @unique
  userId         String                   @db.Uuid
  subject        String                   // e.g., "Need Certificate for Rent Agreement"
  description    String?                  // extra details by user
  status         CertificateRequestStatus @default(PENDING)
  pendingPayment Boolean                  @default(false)
  docRequired    Boolean                  @default(false)
  isResolved     Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  resolvedAt     DateTime?
  deletedAt      DateTime?
  user           User                     @relation("UserCertificateRequests", fields: [userId], references: [id], onDelete: Cascade)
  updates        CertificateUpdate[]      // All messages & admin updates
  paymentCharges PaymentCharge[]
}

model CertificateUpdate {
  id                    String              @id @default(uuid()) @db.Uuid
  certificateRequestId  String              @db.Uuid
  updatedBy             String              @db.Uuid
  chargesRequired       Decimal?
  message               String?
  transactionId         String?             @unique
  attachmentUrl         String?             // Admin can attach the certificate file
  attachmentPublicId    String?             // For cloud storage (like Cloudinary)
  newStatus             CertificateRequestStatus?
  paymentId             String?
  prevStatus            CertificateRequestStatus?
  createdAt             DateTime            @default(now())
  updateType            CertificateUpdateType
  certificateRequest    CertificateRequest  @relation(fields: [certificateRequestId], references: [id], onDelete: Cascade)
  updater               User                @relation("UserCertificateUpdates", fields: [updatedBy], references: [id], onDelete: Cascade)
  sourcePaymentCharge   PaymentCharge?
}


enum Role {
  ADMIN
  COADMIN
  USER
}

enum OtpPurpose {
  SIGNUP_PHONE
  LOGIN_PHONE
}

enum AssetStatus {
  TEMPORARY
  ATTACHED
  DELETED
}

enum AssetContext {
  DOCUMENT
  APPLICATION_UPDATE
  CERTIFICATE_UPDATE
}

enum InvitationDeliveryStatus {
  PENDING
  SENT
  FAILED
}
enum TokenType {
  REFRESH
  FCM
  OTHER
}

enum CertificateRequestStatus {
  PENDING       // User requested
  PAYMENT_REQUIRED
  UNDER_REVIEW  // Admin reviewing
  APPROVED      // Admin approved, waiting for upload
  REJECTED      // Admin rejected
  COMPLETED     // Certificate provided
  CLOSED
}



enum CertificateUpdateType {
  USER_MESSAGE        // User sent message or clarification
  ADMIN_MESSAGE       // Admin replied
  CERTIFICATE_PROVIDED // Admin uploaded certificate
  STATUS_CHANGE        // Status updated (like approved/rejected)
  SYSTEM_GENERATED
  PAYMENT_FAILED
  PAYMENT_SUCCESS
  PAYMENT_REQUESTED
}



enum PaymentType {
  INITIAL
  OBJECTION
  ADDITIONAL
  CORRECTION
}


enum ApplicationStatus { 
  AWAITING_ACTION
  PAYMENT_REQUIRED
  PAYMENT_DONE
  DATA_REQUIRED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  CLOSED
}


enum UpdateType {
  USER_MESSAGE
  ADMIN_MESSAGE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  STATUS_CHANGE
  DOCUMENT_UPDATED
  PAYMENT_REQUESTED
  SYSTEM_GENERATED
}


enum PaymentGateway {
  RAZORPAY
}

enum PaymentTargetType {
  APPLICATION
  CERTIFICATE
  PLAN
}

enum PaymentCategory {
  INITIAL
  OBJECTION
  ADDITIONAL
  CORRECTION
  PLAN
}

enum PaymentChargeStatus {
  OPEN
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentAttemptStatus {
  CREATING
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  EXPIRED
  DUPLICATE_SUCCESS
}

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentRefundStatus {
  REQUESTED
  PENDING
  PROCESSED
  FAILED
}

enum AudienceType {
  ALL
  SPECIFIC
  ROLE_BASED
}
