{
	email {$ACME_EMAIL}
}

{$API_DOMAIN:api.legaldhara.com} {
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	reverse_proxy api:4001 {
		health_uri /health
		health_interval 10s
		health_timeout 3s
		lb_try_duration 5s
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
